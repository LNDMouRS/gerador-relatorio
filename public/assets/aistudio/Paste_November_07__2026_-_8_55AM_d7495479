// Pré-processamento em Canvas (redimensiona e aumenta contraste para melhorar precisão do OCR)
function preProcessarImagem(base64Str) {
    return new Promise((resolve) => {
        let img = new Image();
        img.onload = function() {
            let canvas = document.createElement('canvas');
            let maxDim = 1600;
            let width = img.width;
            let height = img.height;

            if (width > height && width > maxDim) {
                height *= maxDim / width;
                width = maxDim;
            } else if (height > maxDim) {
                width *= maxDim / height;
                height = maxDim;
            }

            canvas.width = width;
            canvas.height = height;
            let ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, width, height);

            // Converte para tons de cinza com ganho de contraste
            let imgData = ctx.getImageData(0, 0, width, height);
            let data = imgData.data;
            for (let i = 0; i < data.length; i += 4) {
                let cinza = 0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2];
                // Contraste leve para destacar letras escuras do fundo do RG/CNH
                cinza = cinza < 128 ? Math.max(0, cinza - 20) : Math.min(255, cinza + 20);
                data[i] = data[i + 1] = data[i + 2] = cinza;
            }
            ctx.putImageData(imgData, 0, 0);
            resolve(canvas.toDataURL('image/jpeg', 0.9));
        };
        img.src = base64Str;
    });
}

async function executarOCR() {
    if (!fotoDocumentoBase64) return;

    let statusBox = document.getElementById('ocr_status_box');
    let statusText = document.getElementById('ocr_status_text');
    let progressFill = document.getElementById('ocr_progress_fill');
    let rawDetails = document.getElementById('ocr_raw_details');
    let rawText = document.getElementById('ocr_raw_text');

    statusBox.classList.remove('hidden');
    statusText.textContent = "Preparando imagem para leitura...";
    progressFill.style.width = "10%";

    try {
        let imgOtimizada = await preProcessarImagem(fotoDocumentoBase64);

        const resultado = await Tesseract.recognize(
            imgOtimizada,
            'por',
            {
                logger: m => {
                    if (m.status === 'recognizing text') {
                        let pct = Math.round(m.progress * 100);
                        progressFill.style.width = pct + "%";
                        statusText.textContent = `Lendo documento... (${pct}%)`;
                    }
                }
            }
        );

        let textoExtraido = resultado.data.text || "";
        rawText.value = textoExtraido;
        rawDetails.classList.remove('hidden');

        let qtdExtraida = extrairDadosDoTexto(textoExtraido);

        progressFill.style.width = "100%";
        if (qtdExtraida > 0) {
            statusText.textContent = `✅ Leitura concluída! ${qtdExtraida} campo(s) preenchido(s) automaticamente.`;
        } else {
            statusText.textContent = "⚠️ Leitura concluída, mas não foi possível identificar os padrões automaticamente. Confira o texto bruto abaixo.";
        }
    } catch (erro) {
        console.error("Erro no OCR:", erro);
        statusText.textContent = "❌ Não foi possível ler a imagem automaticamente. Verifique a conexão ou preencha manualmente.";
    }
}

function destacarCampo(id) {
    let el = document.getElementById(id);
    if (!el) return;
    el.classList.add('campo-preenchido-ocr');
    setTimeout(() => {
        el.classList.remove('campo-preenchido-ocr');
    }, 3000);
}

function extrairDadosDoTexto(texto) {
    let camposPreenchidos = 0;
    let textoLimpo = texto.toUpperCase();
    let linhas = textoLimpo.split(/\r?\n/).map(l => l.trim()).filter(l => l.length > 2);

    // 1. EXTRAIR CPF (Formato 000.000.000-00, 000000000/00 ou 11 dígitos)
    let regexCPF = /\b(\d{3})[\.\s]?(\d{3})[\.\s]?(\d{3})[-\/\.\s](\d{2})\b/;
    let matchCPF = textoLimpo.match(regexCPF);
    if (!matchCPF) {
        // Tenta buscar 11 números seguidos próximos à palavra CPF
        let matchCpfSemMascara = textoLimpo.match(/CPF[:\s\.\-]*(\d{11})\b/);
        if (matchCpfSemMascara) {
            let num = matchCpfSemMascara[1];
            matchCPF = [num, num.slice(0,3), num.slice(3,6), num.slice(6,9), num.slice(9,11)];
        }
    }
    if (matchCPF) {
        let campoCpf = document.getElementById('cpf');
        campoCpf.value = `${matchCPF[1]}.${matchCPF[2]}.${matchCPF[3]}-${matchCPF[4]}`;
        mascaraCPF(campoCpf);
        destacarCampo('cpf');
        camposPreenchidos++;
    }

    // 2. EXTRAIR DATA DE NASCIMENTO (dd/mm/aaaa)
    let regexData = /\b(0[1-9]|[12][0-9]|3[01])[\/\-\.](0[1-9]|1[012])[\/\-\.](19\d{2}|20\d{2})\b/g;
    let datasEncontradas = [];
    let m;
    let anoAtual = new Date().getFullYear();

    while ((m = regexData.exec(textoLimpo)) !== null) {
        let dia = m[1];
        let mes = m[2];
        let ano = parseInt(m[3], 10);
        if (ano >= 1900 && ano <= anoAtual) {
            datasEncontradas.push({ formatada: `${dia}/${mes}/${ano}`, ano: ano });
        }
    }

    if (datasEncontradas.length > 0) {
        // Em documentos (RG/CNH), a data de nascimento é sempre a data com o menor ano (mais antiga que emissão/validade)
        datasEncontradas.sort((a, b) => a.ano - b.ano);
        let campoDn = document.getElementById('dn');
        campoDn.value = datasEncontradas[0].formatada;
        mascaraData(campoDn); // Já calcula e preenche a Idade automaticamente
        destacarCampo('dn');
        destacarCampo('idade');
        camposPreenchidos++;
    }

    // 3. EXTRAIR NOME DO PACIENTE E MÃE
    const palavrasIgnoradas = [
        "REPUBLICA", "FEDERATIVA", "BRASIL", "GOVERno", "ESTADO", "SECRETARIA",
        "CARTEIRA", "NACIONAL", "HABILITACAO", "IDENTIDADE", "REGISTRO", "GERAL",
        "DEPARTAMENTO", "TRANSITO", "DETRAN", "MINISTERIO", "INFRAESTRUTURA",
        "VALIDADE", "EMISSAO", "LOCAL", "DATA", "NASCIMENTO", "ASSINATURA",
        "PORTADOR", "OBSERVACOES", "CATEGORIA", "PERMISSAO", "PROIBIDO",
        "PLASTIFICAR", "NATURALIDADE", "DOC", "ORIGEM", "CPF", "FILIACAO"
    ];

    function ehLinhaDeNomeValida(str) {
        let limpa = str.replace(/[^A-ZÁÀÂÃÉÈÊÍÏÓÔÕÖÚÇÑ\s]/g, '').trim();
        if (limpa.length < 6) return false;
        let partes = limpa.split(/\s+/);
        if (partes.length < 2) return false;
        for (let p of palavrasIgnoradas) {
            if (limpa.includes(p)) return false;
        }
        return limpa;
    }

    let nomeEncontrado = "";
    let maeEncontrada = "";

    for (let i = 0; i < linhas.length; i++) {
        let linha = linhas[i];

        // Procura marcador de NOME
        if (!nomeEncontrado && /\b(NOME|N0ME)\b/.test(linha) && !linha.includes("SOCIAL")) {
            // Verifica se o nome está na mesma linha após "NOME"
            let posNome = linha.replace(/.*?\b(NOME|N0ME)\b[:\.\-\s]*/, '').trim();
            let validoMesmaLinha = ehLinhaDeNomeValida(posNome);
            if (validoMesmaLinha) {
                nomeEncontrado = validoMesmaLinha;
            } else if (i + 1 < linhas.length) {
                let validoProxLinha = ehLinhaDeNomeValida(linhas[i + 1]);
                if (validoProxLinha) nomeEncontrado = validoProxLinha;
            }
        }

        // Procura marcador de FILIAÇÃO / MÃE
        if (!maeEncontrada && /\b(FILIACAO|FILIAÇÃO|MAE|MÃE)\b/.test(linha)) {
            // Em RG e CNH, a filiação costuma ter Pai na 1ª linha e Mãe na 2ª linha (ou apenas Mãe)
            let candidatosFiliacao = [];
            for (let j = i + 1; j <= Math.min(i + 3, linhas.length - 1); j++) {
                let cand = ehLinhaDeNomeValida(linhas[j]);
                if (cand) candidatosFiliacao.push(cand);
            }
            if (candidatosFiliacao.length >= 2) {
                maeEncontrada = candidatosFiliacao[1]; // Geralmente o 2º nome na filiação é a mãe
            } else if (candidatosFiliacao.length === 1) {
                maeEncontrada = candidatosFiliacao[0];
            }
        }
    }

    if (nomeEncontrado) {
        document.getElementById('paciente').value = nomeEncontrado;
        destacarCampo('paciente');
        camposPreenchidos++;
    }

    if (maeEncontrada) {
        document.getElementById('mae').value = maeEncontrada;
        destacarCampo('mae');
        camposPreenchidos++;
    }

    return camposPreenchidos;
}

