// ==========================================
// MÁSCARA PARA A PRESSÃO ARTERIAL (PA)
// ==========================================
function mascaraPA(input) {
    let valor = input.value.replace(/\D/g, '');
    valor = valor.substring(0, 6);
    if (valor.length > 3) {
        valor = valor.replace(/^(\d{3})(\d)/, '$1/$2');
    }
    input.value = valor;
}

// ==========================================
// MÁSCARA PARA O CPF
// ==========================================
function mascaraCPF(input) {
    let valor = input.value.replace(/\D/g, '');
    valor = valor.substring(0, 11);
    valor = valor.replace(/(\d{3})(\d)/, '$1.$2');
    valor = valor.replace(/(\d{3})(\d)/, '$1.$2');
    valor = valor.replace(/(\d{3})(\d{1,2})$/, '$1-$2');
    input.value = valor;
}

// ==========================================
// MÁSCARA PARA DATA DE NASCIMENTO (DN) E CÁLCULO DE IDADE
// ==========================================
function mascaraData(input) {
    let valor = input.value.replace(/\D/g, '');
    valor = valor.substring(0, 8);
    if (valor.length > 4) {
        valor = valor.replace(/^(\d{2})(\d{2})(\d{1,4})/, '$1/$2/$3');
    } else if (valor.length > 2) {
        valor = valor.replace(/^(\d{2})(\d{1,2})/, '$1/$2');
    }
    input.value = valor;

    if (valor.length === 10) {
        let partes = valor.split('/');
        let dia = parseInt(partes[0], 10);
        let mes = parseInt(partes[1], 10) - 1;
        let ano = parseInt(partes[2], 10);

        let dataNasc = new Date(ano, mes, dia);
        let hoje = new Date();

        let idade = hoje.getFullYear() - dataNasc.getFullYear();
        let diferencaMes = hoje.getMonth() - dataNasc.getMonth();

        if (diferencaMes < 0 || (diferencaMes === 0 && hoje.getDate() < dataNasc.getDate())) {
            idade--;
        }

        if (!isNaN(idade) && idade >= 0 && idade <= 130) {
            document.getElementById('idade').value = idade;
        }
    }
}

// ==========================================
// CÁLCULO DA ESCALA DE GLASGOW (GCS-P)
// ==========================================
function calcularGlasgow() {
    let ocular = parseInt(document.getElementById('glasgow_ocular').value) || 0;
    let verbal = parseInt(document.getElementById('glasgow_verbal').value) || 0;
    let motora = parseInt(document.getElementById('glasgow_motora').value) || 0;

    if (ocular > 0 && verbal > 0 && motora > 0) {
        let total = ocular + verbal + motora;
        let descontoPupila = 0;

        if (!document.getElementById('pupilas_reacao').checked) {
            descontoPupila = 2;
            total = total - descontoPupila;
        }

        if (total < 1) total = 1;

        let textoFinal = total;
        
        if (descontoPupila > 0) {
            textoFinal += " (-2 Pupilas não fotorreativas)";
        }

        document.getElementById('glasgow').value = textoFinal;
    } else {
        document.getElementById('glasgow').value = "";
    }
}

// ==========================================
// GERAR TEXTO DO RELATÓRIO (NOVA SEQUÊNCIA)
// ==========================================
function gerarTexto() {
    let linhas = [];

    function add(label, id) {
        let val = document.getElementById(id).value.trim();
        if (val !== "") {
            linhas.push(label + ": " + val);
        }
    }

    // 1. CHAMADO
    add("Despacho", "despacho");
    add("Endereço", "endereco");

    // 2. IDENTIFICAÇÃO
    let temIdentificacao = (
        document.getElementById('paciente').value.trim() !== "" || 
        document.getElementById('idade').value.trim() !== "" || 
        document.getElementById('dn').value.trim() !== "" || 
        document.getElementById('cpf').value.trim() !== "" || 
        document.getElementById('mae').value.trim() !== "" ||
        fotoDocumentoBase64 !== ""
    );
    if (temIdentificacao && linhas.length > 0) {
        linhas.push(""); 
    }
    add("Paciente", "paciente");
    add("Idade", "idade");
    add("DN", "dn");
    add("CPF", "cpf");
    add("Mãe", "mae");
    if (fotoDocumentoBase64 !== "") {
        linhas.push("Documento: Foto capturada em anexo");
    }

    // 3. PROCEDIMENTO REALIZADO
    let procs = [];
    if (document.getElementById('proc_nenhum').checked) procs.push("sem intervenção");
    if (document.getElementById('proc_padrao').checked) procs.push("abordagem, exame primário e secundário, avaliação e monitoramento dos sinais vitais e transporte");
    if (document.getElementById('proc_imob').checked) procs.push("imobilização, contenção");
    if (document.getElementById('proc_oxig').checked) procs.push("oxigênio terapia");
    if (document.getElementById('proc_inter').checked) procs.push("transporte interhospitalar");
    if (document.getElementById('proc_outro').checked) {
        let textoOutro = document.getElementById('outro_procedimento_texto').value.trim();
        if (textoOutro !== "") procs.push(textoOutro);
    }
    if (procs.length > 0) {
        if (linhas.length > 0) linhas.push("");
        linhas.push("Procedimento realizado: " + procs.join(", "));
    }

    // 4. SINAIS VITAIS & AVALIAÇÃO
    let pa = document.getElementById('pa').value.trim();
    let sat = document.getElementById('sat').value.trim();
    let fc = document.getElementById('fc').value.trim();
    let fr = document.getElementById('fr').value.trim();
    let pupilaTipo = document.getElementById('pupilas_tipo').value;
    let pele = document.getElementById('pele').value.trim();
    let glasgow = document.getElementById('glasgow').value.trim();
    let refeicaoMarcada = document.querySelector('input[name="refeicao"]:checked');
    let alergia = document.getElementById('alergia').value.trim();
    let doencas = document.getElementById('doencas').value.trim();
    let medicamentos = document.getElementById('medicamentos').value.trim();
    
    if (pa || sat || fc || fr || pupilaTipo !== "" || pele || glasgow || refeicaoMarcada || alergia || doencas || medicamentos) {
        if (linhas.length > 0) linhas.push("");
    }

    if (pa !== "") linhas.push("PA: " + pa);
    if (sat !== "") linhas.push("SAT: " + sat + "% a.a");
    if (fc !== "") linhas.push("FC: " + fc + " bpm");
    if (fr !== "") linhas.push("FR: " + fr + " mrpm");
    
    if (pupilaTipo !== "") {
        let pupilaReacao = document.getElementById('pupilas_reacao').checked ? "fotorreativas" : "não fotorreativas";
        linhas.push("Pupilas: " + pupilaTipo + ", " + pupilaReacao);
    }

    add("Pele", "pele");
    add("Glasgow", "glasgow");

    if (refeicaoMarcada) {
        linhas.push("Última refeição: " + refeicaoMarcada.value);
    }
    add("Alergia", "alergia");
    add("Doenças", "doencas");
    add("Medicamentos", "medicamentos");

    // 5. CASO
    let situacao = document.getElementById('situacao').value.trim();
    if (situacao !== "") {
        if (linhas.length > 0) linhas.push("");
        linhas.push("Situação: " + situacao);
    }

    // 6. CENÁRIO / APOIO
    let linhasCenario = [];
    if (document.getElementById('check_pm').checked) {
        let txtCmd = document.getElementsByClassName('txt-apoio-cmd');
        let txtVtr = document.getElementsByClassName('txt-apoio-viatura');
        for (let i = 0; i < txtCmd.length; i++) {
            let cmd = txtCmd[i].value.trim();
            let vtr = txtVtr[i].value.trim();
            if (cmd || vtr) {
                linhasCenario.push("Apoio " + (i + 1) + " -> Comandante: " + (cmd || "N/I") + " | Viatura: " + (vtr || "N/I"));
            }
        }
    }

    if (document.getElementById('check_acidente').checked) {
        let txtVeiculos = document.getElementsByClassName('txt-veiculo');
        let txtPlacas = document.getElementsByClassName('txt-placa');
        let temVeiculo = false;
        let blocoVeiculos = ["Acidente de Trânsito:"]; 
        
        for (let i = 0; i < txtVeiculos.length; i++) {
            let veiculo = txtVeiculos[i].value.trim();
            let placa = txtPlacas[i].value.trim();
            if (veiculo || placa) {
                blocoVeiculos.push("  - Veículo " + (i + 1) + ": " + (veiculo || "N/I") + " | Placa: " + (placa || "N/I"));
                temVeiculo = true;
            }
        }
        if (temVeiculo) linhasCenario.push(...blocoVeiculos);
    }

    if (linhasCenario.length > 0) {
        if (linhas.length > 0) linhas.push("");
        linhas.push(...linhasCenario);
    }

    // 7. REGULAÇÃO
    let regulado = document.getElementById('regulado').value.trim();
    let dr = document.getElementById('dr').value.trim();
    let senha = document.getElementById('senha').value.trim();
    let cuidados = document.getElementById('cuidados').value.trim();

    if (regulado !== "" || dr !== "" || senha !== "" || cuidados !== "") {
        if (linhas.length > 0) linhas.push("");
    }
    
    if (regulado !== "") linhas.push("Regulado para: " + regulado);
    if (dr !== "") linhas.push("Dr: " + dr);
    if (senha !== "") linhas.push("Senha: " + senha);
    if (cuidados !== "") linhas.push("Vítima admitida aos cuidados do(a) " + cuidados);

    // Junta tudo separando por quebra de linha (\n)
    let textoFinal = linhas.join("\n").trim();
    let outputDiv = document.getElementById('output');
    
    if(textoFinal === "") {
        outputDiv.innerHTML = '<span class="output-placeholder">Nenhum dado preenchido. Preencha os campos e clique em "Gerar Relatório".</span>';
    } else {
        outputDiv.textContent = textoFinal;
    }

    document.getElementById('resultado_secao').scrollIntoView({ behavior: 'smooth' });
}

// ==========================================
// COPIAR TEXTO — COMPATÍVEL COM MOBILE
// ==========================================
function copiarTexto() {
    let outputDiv = document.getElementById("output");
    let texto = outputDiv.textContent;

    if (!texto || outputDiv.querySelector('.output-placeholder')) return;

    if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(texto).then(function() {
            mostrarToast();
        }).catch(function() {
            fallbackCopiar(texto);
        });
    } else {
        fallbackCopiar(texto);
    }
}

function fallbackCopiar(texto) {
    let tempInput = document.createElement('textarea');
    tempInput.value = texto;
    tempInput.style.position = 'fixed';
    tempInput.style.left = '-9999px';
    tempInput.style.top = '0';
    tempInput.style.opacity = '0';
    document.body.appendChild(tempInput);
    tempInput.focus();
    tempInput.select();

    let sucesso = false;
    try {
        sucesso = document.execCommand('copy');
    } catch (err) {
        sucesso = false;
    }
    document.body.removeChild(tempInput);

    if (sucesso) {
        mostrarToast();
    } else {
        let range = document.createRange();
        range.selectNodeContents(document.getElementById('output'));
        let sel = window.getSelection();
        sel.removeAllRanges();
        sel.addRange(range);
        alert('Não foi possível copiar automaticamente. O texto foi selecionado — segure e escolha "Copiar" no menu do celular.');
    }
}

function mostrarToast() {
    let toast = document.getElementById("toast");
    toast.style.display = "block";
    setTimeout(function() {
        toast.style.display = "none";
    }, 2500);
}
